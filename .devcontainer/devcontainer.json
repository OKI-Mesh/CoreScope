{
  "name": "CoreScope (CI parity)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/CoreScope",
  "postCreateCommand": "npm ci --production=false && npx playwright install --with-deps chromium",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "golang.go"
      ]
    }
  },
  "remoteEnv": {
    "CI": "true"
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "CoreScope dev", "onAutoForward": "silent" }
  },
  "postStartCommand": "PORT=8080 setsid nohup node scripts/dev-server.js > /tmp/dev-server.log 2>&1 &"
}
