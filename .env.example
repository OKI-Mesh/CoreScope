# Copy to .env (git-ignored) and fill in. docker compose reads .env automatically.

# Required. Use letters and digits only (it is embedded in a URL), for example:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Where the app listens on the host. 127.0.0.1 suits cloudflared or a reverse
# proxy on the same machine; use 0.0.0.0 only behind a firewall.
PROD_APP_BIND=127.0.0.1
PROD_APP_PORT=3000

# Host directory mounted at /app/data: config.json, theme.json and other app data.
# The database is not stored here any more. If config.json sets db.connectionString,
# it overrides DATABASE_URL from compose, so leave that key out for compose deployments.
PROD_DATA_DIR=~/meshcore-data

# Optional bundled services. The default is neither: the app only, with an
# external MQTT broker and your own proxy or tunnel in front.
#   Caddy (TLS on 80/443):   add docker-compose.caddy.yml
#   Mosquitto (MQTT 1883):   add docker-compose.mosquitto.yml
COMPOSE_FILE=docker-compose.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.caddy.yml:docker-compose.mosquitto.yml
# PROD_HTTP_PORT=80
# PROD_HTTPS_PORT=443
# PROD_MQTT_PORT=1883
